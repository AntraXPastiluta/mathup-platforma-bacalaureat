{
  "name": "mathup-platforma-bacalaureat",
  "private": true,
  "description": "Monorepo MathUP — frontend React (Vite) + backend Supabase",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "docker:up": "docker compose up --build frontend",
    "docker:up:local": "docker compose --profile local up --build frontend",
    "docker:preview": "docker compose --profile preview up --build frontend-preview",
    "docker:down": "docker compose down --remove-orphans"
  }
}
