# Edge Function secrets for local Supabase (`supabase start` / `--profile local`).
# Copy to `backend/supabase/.env` (gitignored) or set via `npx supabase secrets set`.
#
# Stripe (Premium checkout / webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# App origin for CORS and Stripe return URLs
APP_URL=http://localhost:5173

# Optional — account deletion emails (EmailJS)
# EMAILJS_SERVICE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# EMAILJS_DELETION_TEMPLATE_ID=
