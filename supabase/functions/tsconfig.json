{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@types/deno"],
    "ignoreDeprecations": "6.0",
    "baseUrl": "../..",
    "paths": {
      "@supabase/supabase-js": ["node_modules/@supabase/supabase-js/dist/module/index.d.ts"],
      "stripe": ["node_modules/stripe/types/index.d.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.d.ts"]
}
